# Timo Second Brain

# --- Vault ---
TIMO_VAULT_PATH=D:\Segundo Cerebro
TIMO_AI_DIR=_AI

# --- OpenAI (get from platform.openai.com) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# --- xAI / Grok (get from console.x.ai) ---
XAI_API_KEY=xai-...
XAI_MODEL=grok-2

# --- Anthropic (optional, if using API directly) ---
ANTHROPIC_API_KEY=sk-ant-...
