# OSCAR AI — SECOND BRAIN
# Copy to .env and fill. NEVER commit .env.

# --- Vault ---
OSCAR_VAULT_PATH=D:\Segundo Cerebro
OSCAR_AI_DIR=_AI

# --- Anthropic (only needed if calling the API directly; Claude Code itself does not need it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- xAI / Grok ---
XAI_API_KEY=
XAI_MODEL=

# --- Local model (optional, for local-only documents) ---
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434

# --- Behaviour ---
OSCAR_DEFAULT_CONFIDENTIALITY=internal
OSCAR_LOG_LEVEL=info
OSCAR_REDACTION_ENABLED=true
