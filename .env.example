# --- Local model (optional, for local-only documents) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# --- Behaviour ---
TIMO_DEFAULT_CONFIDENTIALITY=internal
TIMO_LOG_LEVEL=info
TIMO_REDACTION_ENABLED=true

# --- System ---
NODE_ENV=development
